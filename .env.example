# Backend API Base URL (Used when hosting frontend on Vercel)
# Example: https://api.yourdomain.com/api or https://your-vps-backend.domain.com/api
# If not set, defaults to http://localhost:8000/api in development
VITE_API_URL=https://mso.isp.backend.pmrgsolution.com/api

# Google Maps JavaScript API Key for SentinelOS Live Telemetry
# Required Google Cloud APIs enabled:
# 1. Maps JavaScript API
# 2. Directions API (optional, for route polylines)
# 3. Geocoding API (optional)
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# ── Phase 7A: Map Provider Configuration ──────────────────────────────────────
#
# VITE_MAP_PROVIDER controls the default map rendering engine.
#   "google"  — Google Maps JavaScript API (requires VITE_GOOGLE_MAPS_API_KEY)
#   "open"    — MapLibre GL JS + OpenFreeMap (OSM-derived, no API key required)
#
# Users can also switch providers in-UI via the map engine selector.
# If the selected provider is unavailable, the UI falls back gracefully.
VITE_MAP_PROVIDER=google

# MapLibre vector tile style URL (used when VITE_MAP_PROVIDER=open)
#
# Default: OpenFreeMap "Liberty" style
#   - OSM-derived vector tiles
#   - No API key required
#   - Attribution: © OpenFreeMap contributors, © OpenStreetMap contributors
#   - Usage: https://openfreemap.org
#
# Alternatives:
#   - https://demotiles.maplibre.org/style.json  (MapLibre demo tiles, testing only)
#   - A self-hosted tile server URL
#
# NOTE: Do NOT use https://tile.openstreetmap.org/{z}/{x}/{y}.png directly.
#       The OSM public raster tile service has usage restrictions and no SLA.
#       Use a vector tile provider (OpenFreeMap, Stadia Maps, etc.) for production.
VITE_OPEN_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
